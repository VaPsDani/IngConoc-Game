# Copia a .env y rellena. docker compose lo lee automaticamente.

# OBLIGATORIA: clave que exige host:createSession. Minimo 8 caracteres.
# Genera una con:  node -e "console.log(crypto.randomUUID())"
HOST_KEY=cambia-esto-por-algo-largo

# Dominio publico. Sin dominio propio, usa sslip.io con la IP de la VM y
# guiones en vez de puntos:
#   DOMAIN=140-238-176-12.sslip.io
DOMAIN=localhost


# Caps. Los defectos estan bien para una clase.
MAX_ROOMS=3
MAX_PLAYERS_PER_ROOM=60
ROOM_TTL_MIN=240
LOBBY_IDLE_TTL_MIN=30
